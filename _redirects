# Netlify _redirects file
# Serve all pages/* and static assets directly
/pages/*   /pages/:splat   200
/js/*      /js/:splat      200
/css/*     /css/:splat     200
/icons/*   /icons/:splat   200
/assets/*  /assets/:splat  200
/data/*    /data/:splat    200

# Fallback: SPA-style catch-all (do NOT redirect auth-callback to index.html)
# Auth callback must be served as a real file
/pages/auth-callback.html   /pages/auth-callback.html   200

